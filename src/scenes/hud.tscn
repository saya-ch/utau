; T202 (#118) — HUD 5 verb row 半透明「冷却中」提示. 当 verb 在冷却
; (cooldown ratio > 0) 时此 label 可见, 显示 "冷却中" 半透明白字; verb
; 准备就绪 (ratio == 0) 时隐藏. 5 verb 各有 1 个 label (PulseCooldown
; Label / BindCooldownLabel / CutCooldownLabel / EchoCooldownLabel /
; WaveCooldownLabel), 共享同一 modulate 0.5 alpha (半透明). 玩家可
; 一眼看到 "哪个 verb 还在冷却 / 哪个已就绪" 而无需盯 bar 读比例.
[node name="PulseCooldownLabel" type="Label" parent="MarginContainer/VBoxContainer/PulseRow"]
custom_minimum_size = Vector2(36, 6)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 7
text = "冷却中"
modulate = Color(1, 1, 1, 0.5)
horizontal_alignment = 1
visible = false

