; T204 (#119) — 5 verb 名称标签。位置在 Icon 后、Cooldown 前, 让
; 玩家一眼看出"这一行是哪个 verb", 不必只靠 icon 形状 + progress
; bar 颜色双通道推断。颜色严格对齐 5 verb 主题色 (Amber Voice / 
; Muted Violet / Coral Pulse / Glass Cyan / Pale Resonance), 与
; ProgressBar fill 风格和 T202 (#118) "冷却中" label 主题色一致,
; HUD 5 verb 行色域分工在 3 个 UI 通道 (icon + bar + name label) 100%
; 透明。Always-visible 7pt 小字, 不占额外 row 高度, 不影响 HUD 布局。
[node name="PulseNameLabel" type="Label" parent="MarginContainer/VBoxContainer/PulseRow"]
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 7
theme_override_colors/font_color = Color(0.949, 0.714, 0.431, 1)
text = "Pulse"

[node name="PulseCooldown" type="ProgressBar" parent="MarginContainer/VBoxContainer/PulseRow"]
custom_minimum_size = Vector2(40, 6)
layout_mode = 2
size_flags_vertical = 4
max_value = 100.0
value = 100.0
show_percentage = false
theme_override_styles/background = SubResource("StyleBoxFlat_pulse_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_pulse_fill")

[node name="PulseCooldownLabel" type="Label" parent="MarginContainer/VBoxContainer/PulseRow"]
; T202 (#118) — 半透明"冷却中"提示标签。cooldown 期间显示，
; 玩家不需盯 progress bar 也能立刻知道 verb 不可用。
