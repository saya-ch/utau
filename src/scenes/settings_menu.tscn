tooltip_text = "开启后玩家受击 / Boss 阶段 2 / Wave combo 等屏抖全部关闭 (no-op). 玩家可仍听到 SFX 与看见 VFX, 但不晃动."

[node name="ReduceFlashCheck" type="CheckBox" parent="VBoxContainer/Content/VideoPanel"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 9
text = "减弱屏幕闪烁"
tooltip_text = "开启后 verb 命中色闪 / 死亡灰度洗 / Boss 入场 vignette 等屏幕染色 flash 全部关闭 (no-op). 玩家可仍听到 SFX 与看见 hit 数字, 但不闪屏."

